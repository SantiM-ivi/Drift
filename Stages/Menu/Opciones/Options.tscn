; ── AnimationPlayer intro ──
[sub_resource type="Animation" id="Anim_intro"]
resource_name = "intro"
length = 0.5
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("CenterContainer:modulate")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0.0, 0.5),
"transitions": PackedFloat32Array(1.0, 1.0),
"update": 0,
"values": [Color(0, 0, 0, 0), Color(1, 1, 1, 1)]
}

; ════════════════════════════════════════
;  ÁRBOL DE NODOS
; ════════════════════════════════════════

[node name="Options" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

; ── Fondo imagen (mismo que MainMenu) ──
[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("2_bg")
stretch_mode = 6

; ── Overlay oscuro sobre la imagen ──
[node name="Overlay" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0, 0.0, 0.0, 0.55)

; ── Contenedor central ──
[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

; ── Panel con fondo semitransparente ──
[node name="Panel" type="PanelContainer" parent="CenterContainer"]
layout_mode = 2
custom_minimum_size = Vector2(420, 0)
theme_override_styles/panel = SubResource("SB_Panel")

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer/Panel"]
layout_mode = 2
theme_override_constants/separation = 18

; ── Título ──
[node name="LblTitulo" type="Label" parent="CenterContainer/Panel/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 4
text = "OPCIONES"
theme_override_font_sizes/font_size = 32
theme_override_colors/font_color = Color(0.95, 0.65, 0.10, 1.0)
horizontal_alignment = 1

; ── Separador ──
[node name="HSep" type="HSeparator" parent="CenterContainer/Panel/VBoxContainer"]
