[gd_scene format=3 uid="uid://dbkxohjeklxcc"]

[sub_resource type="GDScript" id="GDScript_xcjhd"]
script/source = "extends Node3D

var _timer: float = 0.0
var _flash_duracion: float = 0.15
var _mesh: MeshInstance3D
var _luz: OmniLight3D

func _ready() -> void:
	# Cilindro delgado y alto simulando el rayo
	_mesh = MeshInstance3D.new()
	var cyl = CylinderMesh.new()
	cyl.top_radius = 0.05
	cyl.bottom_radius = 0.05
	cyl.height = 12.0
	_mesh.mesh = cyl
	
	var mat = StandardMaterial3D.new()
	mat.albedo_color = Color(1.0, 1.0, 0.3)
	mat.emission_enabled = true
	mat.emission = Color(1.0, 1.0, 0.2)
	mat.emission_energy_multiplier = 8.0
	_mesh.material_override = mat
	add_child(_mesh)
	
	# Luz de flash
	_luz = OmniLight3D.new()
	_luz.light_color = Color(0.9, 0.9, 1.0)
	_luz.light_energy = 12.0
	_luz.omni_range = 20.0
	add_child(_luz)
	
	# Auto-destruirse después del flash
	await get_tree().create_timer(_flash_duracion * 3).timeout
	queue_free()

func _process(delta: float) -> void:
	_timer += delta
	# Parpadeo del flash
	var visible_flash = fmod(_timer, _flash_duracion) < (_flash_duracion * 0.5)
	_mesh.visible = visible_flash
	_luz.visible = visible_flash
"

